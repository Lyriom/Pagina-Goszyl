# =====================================================================
# Gozsyl - Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =====================================================================

# --- Aplicación ---
APP_URL=https://gozsyl.cloud
APP_NAME=Gozsyl
APP_DESCRIPTION=Consultoría de producto digital, automatización e inteligencia artificial
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# --- Formulario de contacto ---
CONTACT_RECIPIENT_EMAIL=jriera@gozsyl.cloud
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=jriera@gozsyl.cloud
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=jriera@gozsyl.cloud
SMTP_SECURITY=ssl                # Hostinger: ssl/465; alternativa starttls/587
SMTP_TIMEOUT_SECONDS=10
