# =====================================================================
# Gozsyl - Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =====================================================================

# --- Aplicación ---
APP_URL=https://gozsyl.cloud
APP_NAME=Gozsyl
APP_DESCRIPTION=Consultoría de producto digital, automatización e inteligencia artificial
CONTACT_EMAIL=hola@gozsyl.com
COMPANY_JURISDICTION=Delaware, Estados Unidos
ENVIRONMENT=development          # development | staging | production
DEV_PREVIEW_MODE=false           # true: muestra la web pública sin consultar servicios externos
LOG_LEVEL=INFO

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/gozsyl
