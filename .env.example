# =====================================================================
# Sistema A - Variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# =====================================================================

# --- Aplicacion ---
APP_URL=https://gozsyl.cloud
APP_NAME=Gozsyl
APP_DESCRIPTION=Tecnologia y soluciones digitales
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# --- Sesion / cookies ---
SECRET_KEY=cambiar-esto-en-produccion
SESSION_COOKIE_NAME=sistema_a_session
SESSION_MAX_AGE=86400            # segundos (24h por defecto)

# --- Base de datos ---
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/sistema_a

# --- Keycloak (SSO / 2FA / Federacion) ---
KEYCLOAK_URL=https://auth.gozsyl.cloud
KEYCLOAK_REALM=apuestas-ec
KEYCLOAK_CLIENT_ID=sistema-a
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://gozsyl.cloud/auth/callback
KEYCLOAK_POST_LOGOUT_URI=https://gozsyl.cloud/

# --- Vault (cifrado A -> B) ---
VAULT_URL=https://vault.gozsyl.cloud
VAULT_TOKEN=
VAULT_TRANSIT_KEY=featured-content-key
VAULT_TRANSIT_MOUNT=transit

# --- Sistema B (comparador de cuotas) ---
SISTEMA_B_URL=https://apuestas.gozsyl.cloud
SISTEMA_B_API_KEY=
SISTEMA_B_TIMEOUT=10             # segundos

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
